# ===== موظف الليل - إعدادات =====
# النظام يشتغل فوراً مع Ollama المحلي مجاناً بدون أي مفتاح.
# أضف أي مفتاح هنا ويدخل تلقائياً.

# --- Ollama (مجاني 100% - لا يتطلب مفتاح) ---
SELFRUNNER_MODEL=llama3.1

# --- Google Gemini (مجاني free tier) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- DeepSeek (رخيص جداً) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- OpenRouter (بوابة لنماذج مجانية كثيرة) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Groq (مجاني واسع وسريع جداً) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Anthropic Claude (الأقوى) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Mistral (مجاني) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- NVIDIA NIM (مجاني) ---
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --- إعدادات التشغيل ---
# hybrid = يسأل عقلين ويأخذ الأفضل | smart | fastest | strongest | ollama
SELFRUNNER_MODE=hybrid

# أقصى عدد خطوات (20 افتراضي، 200 للمهام الطويلة)
SELFRUNNER_STEPS=20

# allow = ينفذ بدون سؤال | ask = يسألك | deny = يمنع
SELFRUNNER_AUTORUN=ask

# لوحة العرض: 1 = تفتح تلقائياً | 0 = لا
SELFRUNNER_SHOW_DASHBOARD=0

# منفذ المنصة
SELFRUNNER_PORT=8082

# فاصل الحلقات (ثواني)
SELFRUNNER_LOOP_SECONDS=90

# --- محرك الإتقان master ---
# السقف اليومي لتكلفة العقول (دولار) — فوقه تتوقف المزودات المدفوعة
SELFRUNNER_MAX_COST_USD=2.0
# عدد دورات الإتقان القصوى لكل جلسة
SELFRUNNER_MAX_MASTERY_CYCLES=8
# كل كم ثانية يتحقق من حضورك ليتوقف (وكتكمل غيبتك يستأنف)
SELFRUNNER_POLL_USER_SECONDS=30

# الحكم الدلالي للهجين: 1 = مزود ثالث يقرر الرد الأصح (أعلى دقة، تكلفة إضافية)
#                           0 = التقييم الشكلي فقط (افتراضي)
SELFRUNNER_HYBRID_JUDGE=0

# حد التشغيل للمهمة المجدولة (Task Scheduler) — سخي حتى لا يقطع المهمة
SELFRUNNER_TASK_LIMIT=PT71H

# مهلة اتصال واجهة المنصة (ثواني)
SELFRUNNER_API_TIMEOUT=10

# 1 = يشغّل الاختبارات التي تلمس الإنترنت فعلياً | 0 = يُتخطى (افتراضي)
SELFRUNNER_NETWORK_TESTS=0
