# Environment & Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Project Data (user-specific) — anchored to repo root so they don't swallow
# source packages of the same name (e.g. agent_os/memory/ is code, not data).
/output/
/logs/
/skills/
/memory/
/data/
/projects/
/reports/
*.log
*.json
!package.json
!package-lock.json
!tests/fixtures/**
!tests/**/*.json
!.claude/**/*.json

# خرج الاختبارات المؤقت — يُحذف ويُعاد إنشاؤه كل جلسة (conftest)، لا يُتتبَّع.
tests/_data_isolated/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temp
_selfrun.auto
_task_temp.xml
rejected_ideas.json

# Backup files (لا تُشحن نسخ .bak في المستودع)
*.bak
*.bak_*
*.tmp
